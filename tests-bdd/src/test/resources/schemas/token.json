{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Resposta do login",
  "type": "object",
  "required": [
    "token",
    "tipo",
    "expiraEmSegundos",
    "perfil"
  ],
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Bearer"
      ]
    },
    "expiraEmSegundos": {
      "type": "integer",
      "minimum": 1
    },
    "perfil": {
      "type": "string",
      "enum": [
        "ADMIN",
        "OPERADOR"
      ]
    }
  }
}
