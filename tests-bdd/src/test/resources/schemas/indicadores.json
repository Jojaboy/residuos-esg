    },
    "totalColetas": {
      "type": "integer",
      "minimum": 0
    },
    "coletasAgendadas": {
      "type": "integer",
      "minimum": 0
    },
    "coletasConcluidas": {
      "type": "integer",
      "minimum": 0
    },
    "totalKgReciclado": {
