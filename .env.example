# Copie para .env e ajuste:  cp .env.example .env
# Usado pelo docker compose para rodar LOCALMENTE.

COMPOSE_PROJECT_NAME=residuos-esg-local
APP_ENV=local
SPRING_PROFILES_ACTIVE=default
APP_PORT=8080

# Banco Oracle (o container cria o usuario automaticamente)
ORACLE_PASSWORD=Oracle123
DB_USER=esg_user
DB_PASS=esg_pass

# Chave de assinatura dos tokens JWT (minimo 32 caracteres)
JWT_SECRET=troque-esta-chave-local-com-pelo-menos-32-caracteres
