# Ambiente de PRODUCAO - usado pelo pipeline no job "Deploy Producao"
# Em producao o JWT_SECRET e as senhas DEVEM vir de GitHub Secrets (ver README).
COMPOSE_PROJECT_NAME=residuos-esg-production
APP_ENV=production
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8080

ORACLE_PASSWORD=ProdOracle123
DB_USER=esg_prod
DB_PASS=esg_prod_pass

JWT_SECRET=producao-chave-jwt-substituida-por-secret-no-github
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
