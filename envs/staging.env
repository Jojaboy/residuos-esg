# Ambiente de STAGING (homologacao) - usado pelo pipeline no job "Deploy Staging"
# Segredos reais (JWT_SECRET, senhas) podem ser sobrescritos por GitHub Secrets.
COMPOSE_PROJECT_NAME=residuos-esg-staging
APP_ENV=staging
SPRING_PROFILES_ACTIVE=staging
APP_PORT=8081

ORACLE_PASSWORD=StagingOracle123
DB_USER=esg_staging
DB_PASS=esg_staging_pass

JWT_SECRET=staging-chave-jwt-apenas-para-homologacao-32+
JAVA_OPTS=-XX:MaxRAMPercentage=60.0
